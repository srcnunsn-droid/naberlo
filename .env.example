# Copy to .env for local development; never commit credentials.
STADIUM_OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_VIDEO_MODEL=sora-2
OPENAI_RESEARCH_MODEL=gpt-4.1
PORT=3001
HOST=127.0.0.1
# Optional: require a shared access token when exposing beyond localhost.
STADIUM_ACCESS_TOKEN=
# Optional persistent directory; defaults to .data in the repository.
# STADIUM_DATA_DIR=/path/to/persistent/data
